{
  "openapi": "3.1.1",
  "info": {
    "title": "Spanish speaking platform API",
    "version": "1.0.0",
    "description": "Versioned protocol baseline shared by the Next.js Web product and Flutter clients."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Version 1 modular monolith API"
    }
  ],
  "paths": {
    "/scenarios/{scenarioId}": {
      "get": {
        "summary": "Read one versioned public scenario-practice detail",
        "parameters": [{ "name": "scenarioId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Content-driven scenario detail" }, "404": { "description": "Scenario not found", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } }
      }
    },
    "/scenario-practice/sessions": {
      "post": {
        "summary": "Create an idempotent private scenario practice session",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-session-create-request.schema.json" } } } },
        "responses": {
          "201": { "description": "Scenario session created or restored", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-session-response.schema.json" } } } },
          "400": { "description": "Invalid scenario session request", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "409": { "description": "Scenario session conflict", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Scenario session persistence unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "get": {
        "summary": "List resumable scenario practice sessions owned by the user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Private scenario session list" },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/scenario-practice/sessions/{sessionId}": {
      "get": {
        "summary": "Restore one stable scenario practice checkpoint",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Owned scenario session and completed turns" },
          "404": { "description": "Scenario session not found", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/scenario-practice/sessions/{sessionId}/turns": {
      "post": {
        "summary": "Persist a complete learner turn before requesting a temporary-character reply",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-turn-submit-request.schema.json" } } } },
        "responses": {
          "201": { "description": "Completed user turn persisted" },
          "404": { "description": "Scenario session not found", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "409": { "description": "Revision or turn conflict", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/scenario-practice/sessions/{sessionId}/complete": {
      "post": {
        "summary": "Freeze the session and start an idempotent review/repetition plan",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 128 } }
        ],
        "responses": {
          "202": { "description": "Session frozen; review may still be pending", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-session-response.schema.json" } } } },
          "409": { "description": "Session revision conflict", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/scenario-practice/sessions/{sessionId}/turns/{turnId}/respond": {
      "post": {
        "summary": "Stream a temporary-character reply and persist it only after done",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "turnId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-reply-request.schema.json" } } } },
        "responses": { "200": { "description": "NDJSON meta, delta, optional condition, and terminal done/error frames", "content": { "application/x-ndjson": { "schema": { "$ref": "../../schemas/v1/scenario-reply-frame.schema.json" } } } }, "503": { "description": "Provider unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } }
      }
    },
    "/scenario-practice/sessions/{sessionId}/turns/{turnId}/evaluate": {
      "post": {
        "summary": "Evaluate contextual success for one completed learner turn",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, { "name": "turnId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-evaluation-request.schema.json" } } } },
        "responses": { "200": { "description": "Contextual evaluation", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-evaluation-response.schema.json" } } } }, "202": { "description": "Neutral unavailable review for low-confidence transcription" } }
      }
    },
    "/scenario-practice/sessions/{sessionId}/review": {
      "get": {
        "summary": "Read the complete owned transcript and basic turn reviews",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sessionId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": { "200": { "description": "Basic session review" }, "404": { "description": "Session not found", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } }
      }
    },
    "/explore/dashboard": {
      "get": {
        "summary": "Read the authenticated user's Explore dashboard",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Explore goals and content-pack cards", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/explore-dashboard-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Explore dashboard unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/explore/scenario-suggestions": {
      "post": {
        "summary": "Choose one eligible, explainable scenario for an authenticated user",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-suggestion-request.schema.json" } } } },
        "responses": {
          "200": { "description": "One suggestion or an explicit empty-state fallback", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/scenario-suggestion-response.schema.json" } } } },
          "400": { "description": "Invalid suggestion request", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Suggestion source unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/explore/state": {
      "post": {
        "summary": "Upsert the authenticated user's content-pack discovery state",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/explore-state-input.schema.json" } } } },
        "responses": {
          "200": { "description": "Explore pack state saved", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/explore-state-response.schema.json" } } } },
          "400": { "description": "Invalid state", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Explore state unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/conversations": {
      "get": {
        "summary": "List the authenticated user's persisted conversations",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Conversation summaries" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Conversation list unavailable" }
        }
      }
    },
    "/character-network/lucia-contact": {
      "get": {
        "summary": "Read the authenticated user's Lucía friend-request state",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Lucía contact state", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/lucia-contact-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Contact state unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "post": {
        "summary": "Accept or decline Lucía's friend request",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["decision"], "properties": { "decision": { "enum": ["accept", "decline"] } }, "additionalProperties": false } } } },
        "responses": {
          "200": { "description": "Updated Lucía contact state", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/lucia-contact-response.schema.json" } } } },
          "400": { "description": "Invalid decision", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Contact state unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/transcriptions": {
      "post": {
        "summary": "Transcribe ephemeral conversation audio",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["audio"], "properties": { "audio": { "type": "string", "format": "binary" }, "languageTag": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Editable transcript" },
          "400": { "description": "Invalid audio" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Transcription unavailable" }
        }
      }
    },
    "/content/articles": {
      "get": {
        "summary": "List published article cards",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "topic", "in": "query", "schema": { "type": "string" } },
          { "name": "saved", "in": "query", "schema": { "type": "string", "enum": ["1"] } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 24 } }
        ],
        "responses": {
          "200": { "description": "Published article cards", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/article-list-response.schema.json" } } } },
          "503": { "description": "Content temporarily unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/content/articles/{articleId}": {
      "get": {
        "summary": "Read one published normalized article version",
        "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Published normalized article", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/article-detail-response.schema.json" } } } },
          "404": { "description": "Article is missing, unpublished, or retired", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/articles/{articleId}/state": {
      "get": {
        "summary": "Read the authenticated user's progress and annotations",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Reading state or null", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/reading-state-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Reading state unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "patch": {
        "summary": "Replace the authenticated user's reading state",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/reading-state-patch.schema.json" } } } },
        "responses": {
          "200": { "description": "Reading state saved", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/reading-state-response.schema.json" } } } },
          "400": { "description": "Malformed state", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "409": { "description": "Article version changed", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Reading state unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/saved": {
      "get": {
        "summary": "List the authenticated user's saved article IDs",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Saved article IDs", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-articles-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "post": {
        "summary": "Save or unsave a published article",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-article-patch.schema.json" } } } },
        "responses": {
          "200": { "description": "Save state updated", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-article-response.schema.json" } } } },
          "400": { "description": "Malformed save request", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "404": { "description": "Article unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "delete": {
        "summary": "Remove a saved article",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "articleId", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Save removed", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-article-response.schema.json" } } } },
          "400": { "description": "Malformed save request", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/sources": {
      "get": {
        "summary": "List saved external source metadata",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Saved source metadata", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-sources-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "post": {
        "summary": "Save external source metadata without fetching content",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-source-input.schema.json" } } } },
        "responses": {
          "200": { "description": "Source metadata saved", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-source-response.schema.json" } } } },
          "400": { "description": "Invalid or unsupported URL", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "delete": {
        "summary": "Delete saved external source metadata",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sourceId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Source deleted", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/deleted-response.schema.json" } } } },
          "400": { "description": "Invalid source ID", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/generated-stories": {
      "get": {
        "summary": "List the authenticated user's private AI drafts",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "search", "in": "query", "schema": { "type": "string" } }, { "name": "cursor", "in": "query", "schema": { "type": "string" } }, { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 24 } }],
        "responses": { "200": { "description": "Private generated story cards", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-list-response.schema.json" } } } }, "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } }
      },
      "post": {
        "summary": "Generate and save a private Spanish reading draft",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 128 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-request.schema.json" } } } },
        "responses": { "201": { "description": "Private generated draft", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-detail-response.schema.json" } } } }, "400": { "description": "Invalid generation input", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }, "409": { "description": "Idempotency conflict", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }, "503": { "description": "Generation unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } }
      }
    },
    "/read/generated-stories/{articleId}": {
      "get": { "summary": "Read one private generated draft", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Private generated article", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-detail-response.schema.json" } } } }, "404": { "description": "Not found or not owned", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } } },
      "delete": { "summary": "Delete one private generated draft", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Draft deleted" }, "404": { "description": "Not found or not owned", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } } }
    },
    "/auth/session": {
      "get": {
        "summary": "Verify the current authenticated session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/v1/auth-session-response.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/practice/sessions/{sessionId}/activity": {
      "post": {
        "summary": "Record a foreground learning activity heartbeat",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../schemas/v1/learning-activity-event.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activity event accepted or already recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/v1/learning-activity-response.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid activity event",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "404": {
            "description": "Practice session not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "409": {
            "description": "Practice session is closed",
            "content": {
              "application/json": {
