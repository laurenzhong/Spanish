{
  "openapi": "3.1.1",
  "info": {
    "title": "Spanish speaking platform API",
    "version": "1.0.0",
    "description": "Versioned protocol baseline shared by the Next.js Web product and Flutter clients."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Version 1 modular monolith API"
    }
  ],
  "paths": {
    "/explore/dashboard": {
      "get": {
        "summary": "Read the authenticated user's Explore dashboard",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Explore goals and content-pack cards", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/explore-dashboard-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Explore dashboard unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/conversations": {
      "get": {
        "summary": "List the authenticated user's persisted conversations",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Conversation summaries" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Conversation list unavailable" }
        }
      }
    },
    "/transcriptions": {
      "post": {
        "summary": "Transcribe ephemeral conversation audio",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["audio"], "properties": { "audio": { "type": "string", "format": "binary" }, "languageTag": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Editable transcript" },
          "400": { "description": "Invalid audio" },
          "401": { "description": "Authentication required" },
          "503": { "description": "Transcription unavailable" }
        }
      }
    },
    "/content/articles": {
      "get": {
        "summary": "List published article cards",
        "parameters": [
          { "name": "search", "in": "query", "schema": { "type": "string" } },
          { "name": "topic", "in": "query", "schema": { "type": "string" } },
          { "name": "saved", "in": "query", "schema": { "type": "string", "enum": ["1"] } },
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 24 } }
        ],
        "responses": {
          "200": { "description": "Published article cards", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/article-list-response.schema.json" } } } },
          "503": { "description": "Content temporarily unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/content/articles/{articleId}": {
      "get": {
        "summary": "Read one published normalized article version",
        "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Published normalized article", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/article-detail-response.schema.json" } } } },
          "404": { "description": "Article is missing, unpublished, or retired", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/articles/{articleId}/state": {
      "get": {
        "summary": "Read the authenticated user's progress and annotations",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Reading state or null", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/reading-state-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Reading state unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "patch": {
        "summary": "Replace the authenticated user's reading state",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/reading-state-patch.schema.json" } } } },
        "responses": {
          "200": { "description": "Reading state saved", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/reading-state-response.schema.json" } } } },
          "400": { "description": "Malformed state", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "409": { "description": "Article version changed", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "503": { "description": "Reading state unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/saved": {
      "get": {
        "summary": "List the authenticated user's saved article IDs",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Saved article IDs", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-articles-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "post": {
        "summary": "Save or unsave a published article",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-article-patch.schema.json" } } } },
        "responses": {
          "200": { "description": "Save state updated", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-article-response.schema.json" } } } },
          "400": { "description": "Malformed save request", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } },
          "404": { "description": "Article unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "delete": {
        "summary": "Remove a saved article",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "articleId", "in": "query", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Save removed", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-article-response.schema.json" } } } },
          "400": { "description": "Malformed save request", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/sources": {
      "get": {
        "summary": "List saved external source metadata",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Saved source metadata", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-sources-response.schema.json" } } } },
          "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "post": {
        "summary": "Save external source metadata without fetching content",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-source-input.schema.json" } } } },
        "responses": {
          "200": { "description": "Source metadata saved", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/saved-source-response.schema.json" } } } },
          "400": { "description": "Invalid or unsupported URL", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "delete": {
        "summary": "Delete saved external source metadata",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "sourceId", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "responses": {
          "200": { "description": "Source deleted", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/deleted-response.schema.json" } } } },
          "400": { "description": "Invalid source ID", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      }
    },
    "/read/generated-stories": {
      "get": {
        "summary": "List the authenticated user's private AI drafts",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "search", "in": "query", "schema": { "type": "string" } }, { "name": "cursor", "in": "query", "schema": { "type": "string" } }, { "name": "pageSize", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 24 } }],
        "responses": { "200": { "description": "Private generated story cards", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-list-response.schema.json" } } } }, "401": { "description": "Authentication required", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } }
      },
      "post": {
        "summary": "Generate and save a private Spanish reading draft",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 8, "maxLength": 128 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-request.schema.json" } } } },
        "responses": { "201": { "description": "Private generated draft", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-detail-response.schema.json" } } } }, "400": { "description": "Invalid generation input", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }, "409": { "description": "Idempotency conflict", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }, "503": { "description": "Generation unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } }
      }
    },
    "/read/generated-stories/{articleId}": {
      "get": { "summary": "Read one private generated draft", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Private generated article", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/generated-story-detail-response.schema.json" } } } }, "404": { "description": "Not found or not owned", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } } },
      "delete": { "summary": "Delete one private generated draft", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "articleId", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Draft deleted" }, "404": { "description": "Not found or not owned", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } } } }
    },
    "/auth/session": {
      "get": {
        "summary": "Verify the current authenticated session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/v1/auth-session-response.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/practice/sessions/{sessionId}/activity": {
      "post": {
        "summary": "Record a foreground learning activity heartbeat",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../schemas/v1/learning-activity-event.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activity event accepted or already recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/v1/learning-activity-response.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid activity event",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "404": {
            "description": "Practice session not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "409": {
            "description": "Practice session is closed",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/profile/memories": {
      "get": {
        "summary": "List the authenticated user's relationship memories",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Relationship memories owned by the user",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/profile-memories-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete one relationship memory and its sharing grants",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "memoryId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["apiVersion", "data"],
                  "properties": {
                    "apiVersion": { "const": "v1" },
                    "data": {
                      "type": "object",
                      "required": ["deleted"],
                      "properties": { "deleted": { "type": "boolean" } }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid memory ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/profile/media": {
      "get": {
        "summary": "List saved audio and speech transcripts owned by the user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Saved voice data",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/profile-media-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete one saved audio asset or speech transcript",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "kind", "in": "query", "required": true, "schema": { "type": "string", "enum": ["audio", "transcript"] } },
          { "name": "id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Deletion result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["apiVersion", "data"],
                  "properties": {
                    "apiVersion": { "const": "v1" },
                    "data": {
                      "type": "object",
                      "required": ["deleted", "id", "kind"],
                      "properties": {
                        "deleted": { "type": "boolean" },
                        "id": { "type": "string", "format": "uuid" },
                        "kind": { "enum": ["audio", "transcript"] }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid media kind or ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/me/data": {
      "get": {
        "summary": "Summarize the authenticated user's private account data",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Private account data summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/account-data-summary-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "503": {
            "description": "Account data summary is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete the authenticated user's private account data",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["confirmation"],
                "properties": {
                  "confirmation": { "const": "DELETE_MY_DATA" }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private account data deletion result",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/account-data-deletion-response.schema.json" }
              }
            }
          },
          "400": {
            "description": "Missing explicit deletion confirmation",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
                "application/json": {
                  "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
                }
            }
          },
          "503": {
            "description": "Account data deletion is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Read the authenticated user's account profile",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Account profile", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/account-profile-response.schema.json" } } } },
          "401": { "description": "Authentication required" },
          "503": { "description": "Account profile unavailable", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/error-response.schema.json" } } } }
        }
      },
      "patch": {
        "summary": "Update the authenticated user's account profile",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/account-profile-patch.schema.json" } } } },
        "responses": {
          "200": { "description": "Updated account profile", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/account-profile-response.schema.json" } } } },
          "400": { "description": "Invalid profile input" },
          "409": { "description": "Concurrent profile update" }
        }
      }
    },
    "/me/avatar": {
      "post": {
        "summary": "Upload a normalized account avatar",
        "security": [{ "bearerAuth": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "required": ["file"], "properties": { "file": { "type": "string", "format": "binary" }, "attemptId": { "type": "string" } } } } } },
        "responses": {
          "200": { "description": "Updated account profile", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/avatar-upload-response.schema.json" } } } },
          "400": { "description": "Invalid image" },
          "503": { "description": "Avatar storage unavailable" }
        }
      },
      "delete": {
        "summary": "Remove the authenticated user's uploaded avatar",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Initials avatar restored", "content": { "application/json": { "schema": { "$ref": "../../schemas/v1/avatar-upload-response.schema.json" } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "$ref": "../../schemas/v1/api-error.schema.json"
      },
      "ErrorResponse": {
        "$ref": "../../schemas/v1/error-response.schema.json"
      },
      "PageInfo": {
        "$ref": "../../schemas/v1/page-info.schema.json"
      },
      "SuccessResponse": {
        "$ref": "../../schemas/v1/success-response.schema.json"
      },
      "AuthSessionResponse": {
        "$ref": "../../schemas/v1/auth-session-response.schema.json"
      },
      "ContentBundle": {
        "$ref": "../../schemas/v1/content-bundle.schema.json"
      }
    }
  }
}
