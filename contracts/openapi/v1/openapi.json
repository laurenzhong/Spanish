{
  "openapi": "3.1.1",
  "info": {
    "title": "Spanish speaking platform API",
    "version": "1.0.0",
    "description": "Versioned protocol baseline shared by the Next.js Web product and Flutter clients."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Version 1 modular monolith API"
    }
  ],
  "paths": {
    "/auth/session": {
      "get": {
        "summary": "Verify the current authenticated session",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated identity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/v1/auth-session-response.schema.json"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/practice/sessions/{sessionId}/activity": {
      "post": {
        "summary": "Record a foreground learning activity heartbeat",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../../schemas/v1/learning-activity-event.schema.json"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activity event accepted or already recorded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/v1/learning-activity-response.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Invalid activity event",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "404": {
            "description": "Practice session not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "409": {
            "description": "Practice session is closed",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/profile/memories": {
      "get": {
        "summary": "List the authenticated user's relationship memories",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Relationship memories owned by the user",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/profile-memories-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete one relationship memory and its sharing grants",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "memoryId",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["apiVersion", "data"],
                  "properties": {
                    "apiVersion": { "const": "v1" },
                    "data": {
                      "type": "object",
                      "required": ["deleted"],
                      "properties": { "deleted": { "type": "boolean" } }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid memory ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/profile/media": {
      "get": {
        "summary": "List saved audio and speech transcripts owned by the user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Saved voice data",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/profile-media-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete one saved audio asset or speech transcript",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "kind", "in": "query", "required": true, "schema": { "type": "string", "enum": ["audio", "transcript"] } },
          { "name": "id", "in": "query", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Deletion result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["apiVersion", "data"],
                  "properties": {
                    "apiVersion": { "const": "v1" },
                    "data": {
                      "type": "object",
                      "required": ["deleted", "id", "kind"],
                      "properties": {
                        "deleted": { "type": "boolean" },
                        "id": { "type": "string", "format": "uuid" },
                        "kind": { "enum": ["audio", "transcript"] }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid media kind or ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    },
    "/me/data": {
      "get": {
        "summary": "Summarize the authenticated user's private account data",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Private account data summary",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/account-data-summary-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "503": {
            "description": "Account data summary is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete the authenticated user's private account data",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "minLength": 8, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["confirmation"],
                "properties": {
                  "confirmation": { "const": "DELETE_MY_DATA" }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Private account data deletion result",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/account-data-deletion-response.schema.json" }
              }
            }
          },
          "400": {
            "description": "Missing explicit deletion confirmation",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token",
            "content": {
                "application/json": {
                  "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
                }
            }
          },
          "503": {
            "description": "Account data deletion is temporarily unavailable",
            "content": {
              "application/json": {
                "schema": { "$ref": "../../schemas/v1/error-response.schema.json" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiError": {
        "$ref": "../../schemas/v1/api-error.schema.json"
      },
      "ErrorResponse": {
        "$ref": "../../schemas/v1/error-response.schema.json"
      },
      "PageInfo": {
        "$ref": "../../schemas/v1/page-info.schema.json"
      },
      "SuccessResponse": {
        "$ref": "../../schemas/v1/success-response.schema.json"
      },
      "AuthSessionResponse": {
        "$ref": "../../schemas/v1/auth-session-response.schema.json"
      },
      "ContentBundle": {
        "$ref": "../../schemas/v1/content-bundle.schema.json"
      }
    }
  }
}
