{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-series-save-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "idempotencyKey",
    "expectedRevision",
    "title",
    "summary",
    "kind",
    "orderMode",
    "status",
    "reason",
    "evidence",
    "members",
    "removeStableKeys",
    "fromSeriesRevisions"
  ],
  "properties": {
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120,
      "pattern": "^[a-zA-Z0-9._:-]+$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "kind": {
      "enum": [
        "video",
        "podcast"
      ]
    },
    "orderMode": {
      "enum": [
        "ordered",
        "episodic"
      ]
    },
    "status": {
      "enum": [
        "active",
        "archived"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "members": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stableKey",
          "position",
          "seasonNumber",
          "episodeNumber",
          "episodeLabel",
          "evidence"
        ],
        "properties": {
          "stableKey": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{2,199}$"
          },
          "position": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 2147483647
          },
          "seasonNumber": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483647
          },
          "episodeNumber": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483647
          },
          "episodeLabel": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 120
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "removeStableKeys": {
      "type": "array",
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,199}$"
      }
    },
    "fromSeriesRevisions": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{2,199}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    }
  }
}
