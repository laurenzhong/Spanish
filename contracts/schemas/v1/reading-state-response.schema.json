{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/reading-state-response.schema.json",
  "title": "Reading state response v1",
  "type": "object",
  "required": ["apiVersion", "data"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": { "$ref": "#/$defs/state" }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["position", "text"],
      "additionalProperties": false,
      "properties": {
        "position": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "state": {
      "type": ["object", "null"],
      "required": ["articleId", "contentHash", "highlights", "lastOpenedAt", "note", "position", "saved", "savedPhrases", "status"],
      "additionalProperties": false,
      "properties": {
        "articleId": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "highlights": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "lastOpenedAt": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "maxLength": 2000 },
        "position": { "type": "integer", "minimum": 0 },
        "saved": { "type": "boolean" },
        "savedPhrases": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "status": { "enum": ["in_progress", "completed"] }
      }
    }
  }
}
