{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/scenario-suggestion-response.schema.json",
  "title": "Scenario suggestion response",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "data"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "suggestionSessionId", "scenario", "reasons", "eligibleCount", "canSwap", "limitReached", "fallback"],
      "properties": {
        "requestId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "suggestionSessionId": { "type": "string", "minLength": 8, "maxLength": 128 },
        "scenario": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["stableKey", "title", "description", "cefr", "category", "categoryLabel", "role", "communicationGoal", "sourceKind", "route"],
          "properties": {
            "stableKey": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "cefr": { "enum": ["A1", "A2", "B1", "B2", "C1", "C2"] },
            "category": { "type": "string", "minLength": 1 },
            "categoryLabel": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 },
            "communicationGoal": { "type": "string", "minLength": 1 },
            "sourceKind": { "enum": ["public", "personal"] },
            "route": { "type": "string", "minLength": 1 }
          }
        },
        "reasons": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "text"],
            "properties": {
              "code": { "enum": ["saved-expression", "reliable-gap", "level-match", "new-category", "new-goal", "fresh-scenario", "safe-start", "personal-scenario"] },
              "text": { "type": "string", "minLength": 1 }
            }
          }
        },
        "eligibleCount": { "type": "integer", "minimum": 0 },
        "canSwap": { "type": "boolean" },
        "limitReached": { "type": "boolean" },
        "fallback": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["canGeneratePersonalScenario", "topicChips"],
          "properties": {
            "canGeneratePersonalScenario": { "type": "boolean" },
            "topicChips": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
