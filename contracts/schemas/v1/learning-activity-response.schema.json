{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sueno.local/contracts/v1/learning-activity-response.schema.json",
  "title": "Learning activity response",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "data"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["inserted", "duplicate"]
        }
      }
    }
  }
}
