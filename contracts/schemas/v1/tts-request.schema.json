{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tts-request.schema.json",
  "title": "Unified read-aloud request",
  "type": "object",
  "additionalProperties": false,
  "required": ["text"],
  "properties": {
    "text": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S" },
    "languageTag": { "type": "string", "const": "es-ES", "default": "es-ES" }
  }
}
