{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/scenario-session-create-request.schema.json",
  "title": "Create scenario practice session request",
  "type": "object",
  "additionalProperties": false,
  "required": ["clientAttemptId", "contentVersion", "primaryModality"],
  "properties": {
    "clientAttemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "primaryModality": { "enum": ["speech", "typing"] },
    "scenarioId": { "type": "string", "format": "uuid" },
    "personalScenarioId": { "type": "string", "format": "uuid" }
  },
  "oneOf": [
    {
      "properties": { "scenarioId": {}, "personalScenarioId": {} },
      "required": ["scenarioId"],
      "not": {
        "properties": { "personalScenarioId": {} },
        "required": ["personalScenarioId"]
      }
    },
    {
      "properties": { "scenarioId": {}, "personalScenarioId": {} },
      "required": ["personalScenarioId"],
      "not": {
        "properties": { "scenarioId": {} },
        "required": ["scenarioId"]
      }
    }
  ]
}
