{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/scenario-session-create-request.schema.json",
  "title": "Create scenario practice session request",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "clientAttemptId", "scenarioKey", "primaryModality"],
  "properties": {
    "sessionId": { "type": "string", "format": "uuid" },
    "clientAttemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "primaryModality": { "enum": ["speech", "typing"] },
    "scenarioKey": { "type": "string", "minLength": 1, "maxLength": 160 }
  }
}
