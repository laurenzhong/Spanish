{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/scenario-turn-submit-request.schema.json",
  "title": "Submit scenario practice turn request",
  "type": "object",
  "additionalProperties": false,
  "required": ["attemptId", "expectedRevision", "generationId", "hintLevel", "modality", "text"],
  "properties": {
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "expectedRevision": { "type": "integer", "minimum": 1 },
    "generationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "hintLevel": { "type": "integer", "minimum": 0, "maximum": 3 },
    "modality": { "enum": ["speech", "typing"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "transcriptConfidence": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    }
  }
}
