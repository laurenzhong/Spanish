{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/scenario-turn-submit-request.schema.json",
  "title": "Submit scenario practice turn request",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "clientAttemptId", "turnIndex", "attemptId", "generationId", "modality", "text"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "clientAttemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "turnIndex": { "type": "integer", "minimum": 0 },
    "attemptId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "generationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "modality": { "enum": ["speech", "typing"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
