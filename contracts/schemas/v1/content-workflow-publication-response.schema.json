{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-workflow-publication-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "data"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "publicationRef"],
      "properties": {
        "candidate": { "$ref": "content-workflow-candidate.schema.json" },
        "publicationRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stableKey", "version"],
          "properties": {
            "kind": { "enum": ["article", "media"] },
            "stableKey": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
