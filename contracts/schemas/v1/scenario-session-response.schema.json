{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/scenario-session-response.schema.json",
  "title": "Scenario practice session response",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "data"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "persistence"],
      "properties": {
        "sessionId": { "type": "string", "format": "uuid" },
        "persistence": { "enum": ["account", "device"] },
        "revision": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
