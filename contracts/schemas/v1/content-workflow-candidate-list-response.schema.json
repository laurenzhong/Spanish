{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-workflow-candidate-list-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "data"],
  "properties": {
    "apiVersion": { "const": "v1" },
