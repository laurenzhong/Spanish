{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/saved-reading-items-response.schema.json",
  "title": "Saved reading items response v1",
  "type": "object",
  "required": ["apiVersion", "data"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "required": ["items", "page", "pageSize", "total"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": { "oneOf": [{ "$ref": "#/$defs/readingItem" }, { "$ref": "#/$defs/articleItem" }] }
        },
        "page": { "type": "integer", "minimum": 1 },
        "pageSize": { "type": "integer", "minimum": 1, "maximum": 50 },
        "total": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "readingItem": {
      "type": "object",
      "required": ["id", "articleId", "stableKey", "version", "title", "sourceName", "sourceUrl", "itemType", "text", "position", "context", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "articleId": { "type": "string", "minLength": 3 },
        "stableKey": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "itemType": { "enum": ["phrase", "highlight"] },
        "text": { "type": "string", "minLength": 1 },
        "position": { "type": "integer", "minimum": 0 },
        "context": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "articleItem": {
      "type": "object",
      "required": ["articleId", "stableKey", "version", "title", "sourceName", "sourceUrl", "itemType", "origin", "saved", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "articleId": { "type": "string", "minLength": 3 },
        "stableKey": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "sourceName": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": ["string", "null"], "format": "uri" },
        "itemType": { "const": "article" },
        "origin": { "enum": ["public", "generated"] },
        "saved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
