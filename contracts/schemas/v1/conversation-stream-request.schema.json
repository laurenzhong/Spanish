{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/conversation-stream-request.schema.json",
  "title": "Conversation stream request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "clientMessageId", "generationId"],
  "properties": {
    "characterVersion": { "type": "integer", "minimum": 1 },
    "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "assistance": { "const": "translation" },
    "clientMessageId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "generationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "pendingMessages": {
      "type": "array", "maxItems": 19,
      "description": "Earlier unanswered user messages, oldest first. The latest is in the top-level fields; total batch limit is 20.",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["text", "clientMessageId"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "clientMessageId": { "type": "string", "minLength": 1, "maxLength": 200 },
          "assistance": { "const": "translation" }
        }
      }
    },
    "supersedes": {
      "type": "object", "additionalProperties": false,
      "required": ["generationId", "visibleBubbleCount"],
      "properties": {
        "generationId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "visibleBubbleCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    }
  }
}
