{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-progress-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "expectedRevision", "lastPositionMs", "lastSegmentIndex", "status"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "expectedRevision": { "type": "integer", "minimum": 0 },
    "lastPositionMs": { "type": "integer", "minimum": 0 },
    "lastSegmentIndex": { "type": ["integer", "null"], "minimum": 0 },
    "status": { "enum": ["in_progress", "completed"] }
  }
}
