{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/api-error.schema.json",
  "title": "API error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "VALIDATION_FAILED",
        "AUTH_REQUIRED",
        "FORBIDDEN",
        "RESOURCE_NOT_FOUND",
        "CONFLICT",
        "RATE_LIMITED",
        "PROTOCOL_VERSION_UNSUPPORTED",
        "PROVIDER_TIMEOUT",
        "PROVIDER_UNAVAILABLE",
        "EXPLORE_DASHBOARD_UNAVAILABLE",
        "INTERNAL_ERROR"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "retryable": {
      "type": "boolean"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
