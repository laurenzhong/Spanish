{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spanish.local/contracts/v1/api-error.schema.json",
  "title": "API error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retryable"],
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "VALIDATION_FAILED",
        "AUTH_REQUIRED",
        "FORBIDDEN",
        "RESOURCE_NOT_FOUND",
        "CONFLICT",
        "RATE_LIMITED",
        "PROTOCOL_VERSION_UNSUPPORTED",
        "PROVIDER_TIMEOUT",
        "PROVIDER_UNAVAILABLE",
        "SCENARIO_SESSION_NOT_FOUND",
        "SCENARIO_NOT_FOUND",
        "SCENARIO_SESSION_UNAVAILABLE",
        "SCENARIO_SESSION_CONFLICT",
        "SCENARIO_TURN_CONFLICT",
        "SCENARIO_REPLY_INCOMPLETE",
        "SCENARIO_REVIEW_PENDING",
        "PROVIDER_NOT_CONFIGURED",
        "EXPLORE_DASHBOARD_UNAVAILABLE",
        "EXPLORE_STATE_UNAVAILABLE",
        "SCENARIO_SUGGESTION_UNAVAILABLE",
        "SAVED_EXPRESSION_NOT_FOUND",
        "SAVED_EXPRESSION_SOURCE_NOT_FOUND",
        "SAVED_EXPRESSION_UNAVAILABLE",
        "PERSONAL_SCENARIO_SOURCE_NOT_FOUND",
        "PERSONAL_SCENARIO_UNAVAILABLE",
        "CONTENT_SOURCE_NOT_FOUND",
        "CONTENT_SOURCE_DISABLED",
        "CONTENT_ACQUISITION_CONFLICT",
        "CONTENT_RIGHTS_REQUIRED",
        "CONTENT_BUDGET_EXHAUSTED",
        "CONTENT_PROCESSING_FAILED",
        "CONTENT_WORKFLOW_FORBIDDEN",
        "CONTENT_REVIEW_INCOMPLETE",
        "CONTENT_PUBLISHER_NOT_AVAILABLE",
        "CONTENT_PUBLICATION_CONFLICT",
        "MEDIA_NOT_FOUND",
        "MEDIA_NOT_AVAILABLE",
        "MEDIA_PROGRESS_CONFLICT",
        "INTERNAL_ERROR"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "retryable": {
      "type": "boolean"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
