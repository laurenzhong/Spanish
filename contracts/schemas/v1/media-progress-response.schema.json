{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "media-progress-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "data"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["progress"],
      "properties": {
        "progress": { "$ref": "media-progress.schema.json" }
      }
    }
  }
}
