{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sueno.local/contracts/v1/profile-memories-response.schema.json",
  "title": "Profile relationship memories response",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "data"],
  "properties": {
    "apiVersion": { "const": "v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memories"],
      "properties": {
        "memories": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "characterKey", "content", "createdAt", "id", "sensitivity", "shareScope", "status"],
            "properties": {
              "category": { "type": "string", "minLength": 1 },
              "characterKey": { "type": "string", "minLength": 1 },
              "content": { "type": "string", "minLength": 1 },
              "createdAt": { "type": "string", "format": "date-time" },
              "id": { "type": "string", "format": "uuid" },
              "sensitivity": { "enum": ["normal", "sensitive"] },
              "shareScope": { "enum": ["private", "explicit"] },
              "status": { "enum": ["candidate", "confirmed", "rejected", "conflict"] }
            }
          }
        }
      }
    }
  }
}
