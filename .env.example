# Server-only secrets belong in local `.env` files and must never be committed.
# Only values that are intentionally public may use the NEXT_PUBLIC_ prefix.

# Runtime connection. Use the Supabase transaction pooler in hosted environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Migration connection. Use the direct Supabase PostgreSQL endpoint, not the pooler.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Deterministic local source page used by default tests and explicit fake runs.
# Article RSS sources keep their HTTPS host allowlists, license evidence and
# full-text permission in acquisition_sources.rights_policy, not environment variables.
CONTENT_ACQUISITION_FAKE_FIXTURE=

# Daily article pipeline. Keep disabled until the protected Environment has
# approved the source policy and completed the staged review-only observation.
CONTENT_ARTICLE_DAILY_MODE=disabled
CONTENT_ARTICLE_DAILY_LIMIT=50
CONTENT_ARTICLE_SOURCE_LIMIT=10
CONTENT_ARTICLE_PUBLICATION_POLICY_VERSION=
CONTENT_ARTICLE_AUTO_PUBLISH_KILL_SWITCH=true
CONTENT_ARTICLE_REVIEW_PROVIDER=minimax
CONTENT_ARTICLE_REVIEW_MODEL=MiniMax-M3
CONTENT_ARTICLE_ALLOW_FAKE_REVIEW=0

# Daily media discovery/processing. Auto-publish is capped independently at
# 10 videos and 10 podcasts, and requires a reviewed Spanish + Chinese
# subtitle timeline for every published item. Set the video limit to 0 to
# pause video work while podcast processing continues.
CONTENT_MEDIA_DAILY_MODE=disabled
CONTENT_MEDIA_DAILY_LIMIT=20
CONTENT_MEDIA_VIDEO_DAILY_LIMIT=10
CONTENT_MEDIA_PODCAST_DAILY_LIMIT=10
CONTENT_MEDIA_SOURCE_LIMIT=10
CONTENT_MEDIA_SOURCE_TIMEOUT_MS=180000
CONTENT_MEDIA_CANDIDATE_TIMEOUT_MS=900000
CONTENT_MEDIA_REQUIRE_BILINGUAL_SUBTITLES=true
CONTENT_MEDIA_PROVIDER_MODE=disabled
CONTENT_MEDIA_STT_PROVIDER=minimax
CONTENT_MEDIA_TRANSLATION_PROVIDER=minimax
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TRANSCRIPTION_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
MINIMAX_TRANSCRIPTION_MODEL=asr-1.0
MINIMAX_TRANSCRIPTION_API_ENDPOINT=https://api.minimax.cn/v1/speech_to_text
CONTENT_MEDIA_ASR_MAX_DURATION_MS=3600000
CONTENT_MEDIA_ASR_MAX_ASSET_BYTES=52428800
CONTENT_MEDIA_ASR_MAX_COST_MICROS=2000000
CONTENT_MEDIA_ASR_MIN_CONFIDENCE=0.72

# Server-only credential used only by the verified YouTube channel adapter to
# validate public, embeddable videos through YouTube Data API v3. The key is
# never stored in acquisition source policy or returned to the browser.
YOUTUBE_DATA_API_KEY=

# Optional owner-authorized Netscape cookies for yt-dlp when YouTube blocks
# anonymous downloads. Local runs may use MEDIA_VIDEO_COOKIES_FILE instead;
# never commit either value or the cookies file.
YOUTUBE_COOKIES_B64=
MEDIA_VIDEO_COOKIES_FILE=
# Optional local authorized MP4 for a one-off owner-operated hosting run.
# The host script copies it to a temporary directory and never deletes the source.
MEDIA_VIDEO_LOCAL_FILE=

# Comma-separated Supabase user UUIDs allowed to use the owner-only content
# workflow. Missing or malformed configuration fails closed.
CONTENT_WORKFLOW_OWNER_USER_IDS=

# Public Supabase Auth configuration. These identify the project and are safe
# to expose to Web/Flutter clients; never put a service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase Secret key used to normalize private profile avatars.
# (Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.)
# Create the `profile-avatars` private bucket before enabling photo uploads.
SUPABASE_SECRET_KEY=

# Server-only OpenAI API key. It can be used by speech transcription and, when
# explicitly selected below, the second conversation provider candidate.
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_CONVERSATION_MODEL=gpt-5.6-sol

# Conversation generation remains on MiniMax unless `openai` is selected.
CONVERSATION_PROVIDER=minimax

# Comma-separated user UUIDs allowed to receive the scheduled Lucía message.
# The daily workflow does nothing unless this allowlist is explicitly set.
LUCIA_PROACTIVE_USER_IDS=

# Server-only pronunciation assessment. Never expose this value to Web or Flutter.
SPEECHACE_API_KEY=
SPEECHACE_API_ENDPOINT=https://api.speechace.co/api/scoring/speech/v9/json

# Server-only MiniMax M3 conversation generation and word explanations. Never expose these values to Web or Flutter.
MINIMAX_API_KEY=
MINIMAX_API_ENDPOINT=https://api.minimaxi.com/anthropic/v1/messages
# Optional MiniMax TTS for conversation message read-aloud. The voice ID is
# provider-specific; leave empty to use browser TTS until a voice is selected.
MINIMAX_TTS_API_ENDPOINT=https://api.minimax.cn/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=
