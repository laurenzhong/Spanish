# Server-only secrets belong in local `.env` files and must never be committed.
# Only values that are intentionally public may use the NEXT_PUBLIC_ prefix.

# Runtime connection. Use the Supabase transaction pooler in hosted environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Migration connection. Use the direct Supabase PostgreSQL endpoint, not the pooler.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Deterministic local source page used by default tests and explicit fake runs.
# Article RSS sources keep their HTTPS host allowlists, license evidence and
# full-text permission in acquisition_sources.rights_policy, not environment variables.
CONTENT_ACQUISITION_FAKE_FIXTURE=

# Server-only credential used only by the verified YouTube channel adapter to
# validate public, embeddable videos through YouTube Data API v3. The key is
# never stored in acquisition source policy or returned to the browser.
YOUTUBE_DATA_API_KEY=

# Comma-separated Supabase user UUIDs allowed to use the owner-only content
# workflow. Missing or malformed configuration fails closed.
CONTENT_WORKFLOW_OWNER_USER_IDS=

# Public Supabase Auth configuration. These identify the project and are safe
# to expose to Web/Flutter clients; never put a service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only Supabase Secret key used to normalize private profile avatars.
# (Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.)
# Create the `profile-avatars` private bucket before enabling photo uploads.
SUPABASE_SECRET_KEY=

# Server-only OpenAI API key. It can be used by speech transcription and, when
# explicitly selected below, the second conversation provider candidate.
OPENAI_API_KEY=
OPENAI_API_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_CONVERSATION_MODEL=gpt-5.6-sol

# Conversation generation remains on MiniMax unless `openai` is selected.
CONVERSATION_PROVIDER=minimax

# Server-only pronunciation assessment. Never expose this value to Web or Flutter.
SPEECHACE_API_KEY=
SPEECHACE_API_ENDPOINT=https://api.speechace.co/api/scoring/speech/v9/json

# Server-only MiniMax M3 conversation generation and word explanations. Never expose these values to Web or Flutter.
MINIMAX_API_KEY=
MINIMAX_API_ENDPOINT=https://api.minimaxi.com/anthropic/v1/messages
