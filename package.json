{
  "name": "spanish-speaking-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:contracts": "vitest run tests/contracts",
    "audio:manifest": "tsx scripts/create-audio-replay-manifest.ts",
    "audio:calibration:check": "tsx scripts/check-audio-calibration.ts",
    "audio:calibration:run": "node --use-env-proxy --conditions=react-server --import tsx/esm scripts/run-annotation-calibration.ts",
    "audio:calibration:local-transcribe": "py -3.12 scripts/run-local-whisper-transcription.py",
    "audio:calibration:local-annotate": "node --use-env-proxy --conditions=react-server --import tsx/esm scripts/run-local-annotation-calibration.ts",
    "audio:calibration:manual-annotate": "node --import tsx/esm scripts/create-manual-annotation-drafts.ts",
    "contracts:generate-content": "tsx scripts/generate-content-contract.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:import": "tsx scripts/import-content.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.19.0",
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
